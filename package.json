{
  "name": "noir",
  "version": "0.1.0",
  "description": "Noir — Advanced Per-App Audio Router for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "lint": "eslint .",
    "build": "electron-builder --dir",
    "package": "electron-builder"
  },
  "keywords": [
    "audio",
    "router",
    "windows",
    "volume",
    "sound",
    "electron"
  ],
  "author": "RajX-dev",
  "license": "MIT",
  "dependencies": {
    "native-sound-mixer": "^3.4.6-win"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0"
  },
  "build": {
    "appId": "com.rajx.noir",
    "productName": "Noir",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets/tools",
        "to": "assets/tools"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
